							</outline>
							<outline text="if (idLowestInLastPage !== undefined) {">
								<outline text="params.idlowestinlastpage = idLowestInLastPage;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="wpServerCall (&quot;wordpressgetrangeofdraftsforuser&quot;, params, true, function (err, theDrafts) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="if (theDrafts.length == 0) {">
										<outline text="flAllDraftsLoaded = true;">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="var idLowest = (idLowestInLastPage === undefined) ? Infinity : idLowestInLastPage;">
									</outline>
									<outline text="theDrafts.forEach (function (theDraft) {">
										<outline text="if (theDraft.idDraft &lt; idLowest) {">
											<outline text="idLowest = theDraft.idDraft;">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="idLowestInLastPage = idLowest;">
									</outline>
									<outline text="callback (undefined, theDrafts);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function uploadImageFile (idsite, callback) { //11/11/24 by DW">
						<outline text="Changes" isComment="true">
							<outline text="11/13/24; 10:27:16 AM by DW">
								<outline text="The user interface for choosing and then uploading an image file to the wpidentity server.">
								</outline>
								<outline text="The user chooses a file and we upload it to the indicated site. ">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;uploadImageFile&quot;);">
						</outline>
						<outline text="const theInput = $(&quot;&lt;input type=\&quot;file\&quot; id=\&quot;idImageFileInput\&quot; accept=\&quot;image/*\&quot; style=\&quot;display: none;\&quot;&gt;&quot;);">
						</outline>
						<outline text="$(&quot;body&quot;).append (theInput);">
						</outline>
						<outline text="theInput.on (&quot;change&quot;, function () {">
							<outline text="const theFile = this.files [0];">
							</outline>
							<outline text="if (theFile === undefined) { //no file selected">
								<outline text="theInput.remove ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="const reader = new FileReader ();">
								</outline>
								<outline text="reader.onload = function (ev) {">
									<outline text="const params = {">
										<outline text="name: theFile.name,">
										</outline>
										<outline text="type: theFile.type, ">
										</outline>
										<outline text="idsite">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="const filedata = arrayBufferToBase64 (ev.target.result);">
									</outline>
									<outline text="wpServerPost (&quot;wordpressuploadimage&quot;, params, true, filedata, function (err, data) {">
										<outline text="theInput.remove ();">
										</outline>
										<outline text="callback (err, data);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="reader.readAsArrayBuffer (theFile);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="theInput.click ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function uploadImageFile (callback) { //11/11/24 by DW" isComment="true">
						<outline text="">
						</outline>
						<outline text="Changes" isComment="true">
							<outline text="11/13/24; 10:27:16 AM by DW">
								<outline text="The user interface for choosing and then uploading an image file to the wpidentity server.">
								</outline>
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="">
						</outline>
						<outline text="">
						</outline>
						<outline text="console.log (&quot;uploadImageFile&quot;);">
						</outline>
						<outline text="function arrayBufferToBase64 (buffer) {">
							<outline text="const bytes = new Uint8Array (buffer);">
							</outline>
							<outline text="let binary = &quot;&quot;;">
							</outline>
							<outline text="for (let i = 0; i &lt; bytes.byteLength; i++) {">
								<outline text="binary += String.fromCharCode (bytes [i]);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="return (btoa (binary));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="const theInput = $(&quot;&lt;input type=\&quot;file\&quot; id=\&quot;idImageFileInput\&quot; accept=\&quot;image/*\&quot; style=\&quot;display: none;\&quot;&gt;&quot;);">
						</outline>
						<outline text="$(&quot;body&quot;).append (theInput);">
						</outline>
						<outline text="theInput.on (&quot;change&quot;, function () {">
							<outline text="const file = this.files [0];">
							</outline>
							<outline text="if (file === undefined) { //no file selected">
								<outline text="theInput.remove ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="const reader = new FileReader ();">
								</outline>
								<outline text="reader.onload = function (ev) {">
									<outline text="function uploadImageDirectly (path, arrayBuffer, filetype, filename, idsite, callback) {">
										<outline text="const base64Data = arrayBufferToBase64 (arrayBuffer);">
										</outline>
										<outline text="const params = {">
											<outline text="token: base64UrlEncode (wordpressMemory.accessToken),">
											</outline>
											<outline text="name: filename,">
											</outline>
											<outline text="type: filetype, ">
											</outline>
											<outline text="idsite">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="const url = getServerAddress () + path + &quot;?&quot; + buildParamList (params, false);">
										</outline>
										<outline text="$.ajax ({">
											<outline text="url,">
											</outline>
											<outline text="type: &quot;POST&quot;,">
											</outline>
											<outline text="data: base64Data,">
											</outline>
											<outline text="processData: false, ">
											</outline>
											<outline text="contentType: &quot;text/plain&quot;, ">
											</outline>
											<outline text="success: function (data) {">
												<outline text="callback (undefined, data);">
												</outline>
												<outline text="},">
												</outline>
											</outline>
											<outline text="error: function (jqXHR, message, errorThrown) {">
												<outline text="callback ({message});">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="});">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="">
									</outline>
									<outline text="const filename = &quot;honeypot.png&quot;;">
									</outline>
									<outline text="const idsite = 237777565;">
									</outline>
									<outline text="const filetype = file.type;">
									</outline>
									<outline text="const arrayBuffer = ev.target.result;">
									</outline>
									<outline text="">
									</outline>
									<outline text="console.log (&quot;arrayBuffer length:&quot;, arrayBuffer.byteLength);">
									</outline>
									<outline text="">
									</outline>
									<outline text="uploadImageDirectly (&quot;wordpressuploadimage&quot;, arrayBuffer, filetype, filename, idsite, callback);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="reader.readAsArrayBuffer (file);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="theInput.click ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function uploadImageFile (callback) { //11/11/24 by DW" isComment="true">
						<outline text="console.log (&quot;uploadImageFile&quot;);">
						</outline>
						<outline text="function arrayBufferToBase64 (buffer) {">
							<outline text="const bytes = new Uint8Array (buffer);">
							</outline>
							<outline text="let binary = &quot;&quot;;">
							</outline>
							<outline text="for (let i = 0; i &lt; bytes.byteLength; i++) {">
								<outline text="binary += String.fromCharCode (bytes [i]);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="return (btoa (binary));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="const theInput = $(&quot;&lt;input type=\&quot;file\&quot; id=\&quot;idImageFileInput\&quot; accept=\&quot;image/*\&quot; style=\&quot;display: none;\&quot;&gt;&quot;);">
						</outline>
						<outline text="$(&quot;body&quot;).append (theInput);">
						</outline>
						<outline text="theInput.on (&quot;change&quot;, function () {">
							<outline text="const file = this.files [0];">
							</outline>
							<outline text="if (file === undefined) { //no file selected">
								<outline text="theInput.remove ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="const reader = new FileReader ();">
								</outline>
								<outline text="reader.readAsArrayBuffer (file);">
								</outline>
								<outline text="reader.onload = function (ev) {">
									<outline text="function uploadImageDirectly (path, arrayBuffer, filetype, filename, idsite, callback) {">
										<outline text="const blob = new Blob ([arrayBuffer], {type: filetype});">
										</outline>
										<outline text="const params = {">
											<outline text="token: base64UrlEncode (wordpressMemory.accessToken),">
											</outline>
											<outline text="name: filename,">
											</outline>
											<outline text="type: filetype, ">
											</outline>
											<outline text="idsite">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="const url = getServerAddress () + path + &quot;?&quot; + buildParamList (params, false);">
										</outline>
										<outline text="$.ajax ({">
											<outline text="url,">
											</outline>
											<outline text="type: &quot;POST&quot;,">
											</outline>
											<outline text="data: blob,">
											</outline>
											<outline text="processData: false, ">
											</outline>
											<outline text="contentType: false, ">
											</outline>
											<outline text="success: function (data) {">
												<outline text="callback (undefined, data);">
												</outline>
												<outline text="},">
												</outline>
											</outline>
											<outline text="error: function (jqXHR, message, errorThrown) {">
												<outline text="callback ({message});">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="});">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="">
									</outline>
									<outline text="const filename = &quot;honeypot&quot;;">
									</outline>
									<outline text="const idsite = 237777565;">
									</outline>
									<outline text="const filetype = file.type;">
									</outline>
									<outline text="const arrayBuffer = ev.target.result;">
									</outline>
									<outline text="">
									</outline>
									<outline text="uploadImageDirectly (&quot;wordpressuploadimage&quot;, arrayBuffer, filetype, filename, idsite, callback);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="theInput.click ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function addCategory (idsite, theCategory, callback) { //3/15/25 by DW">
						<outline text="const jsontext = JSON.stringify (theCategory);">
						</outline>
						<outline text="wpServerCall (&quot;wordpressaddcategory&quot;, {idsite, jsontext}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function deleteCategory (idsite, slug, callback) { //3/15/25 by DW">
						<outline text="wpServerCall (&quot;wordpressdeletecategory&quot;, {idsite, slug}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function updateCategory (idsite, slug, theCategory, callback) { //5/11/25 by DW">
						<outline text="const jsontext = JSON.stringify (theCategory);">
						</outline>
						<outline text="wpServerCall (&quot;wordpressupdatecategory&quot;, {idsite, slug, jsontext}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function addPost (idsite, thepost, callback) { //3/24/25 by DW">
						<outline text="if (options.flMarkdownProcess) {">
							<outline text="thepost.content = markdownProcess (thepost.content);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="const jsontext = JSON.stringify (thepost);">
						</outline>
						<outline text="wpServerPost (&quot;wordpressaddpost&quot;, {idsite}, true, jsontext, callback);">
						</outline>
						<outline text="wpServerCall (&quot;wordpressaddpost&quot;, {idsite, jsontext}, true, callback);" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function updatePost (idsite, idpost, thepost, callback) { //3/24/25 by DW">
						<outline text="if (options.flMarkdownProcess) {">
							<outline text="thepost.content = markdownProcess (thepost.content);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="const jsontext = JSON.stringify (thepost);">
						</outline>
						<outline text="wpServerPost (&quot;wordpressupdatepost&quot;, {idsite, idpost}, true, jsontext, callback);">
						</outline>
						<outline text="wpServerCall (&quot;wordpressupdatepost&quot;, {idsite, idpost, jsontext}, true, callback);" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function wsConnectUserToServer () { //5/24/24 by DW">
						<outline text="Changes" isComment="true">
							<outline text="5/4/25; 8:58:10 AM by DW">
								<outline text="When we startup do an initial checkConnection after 1/10th second. ">
								</outline>
								<outline text="Then we check every 10 seconds.">
								</outline>
								<outline text="I didn't like the lag at startup, having to wait 10 secs before we start the connection.">
								</outline>
								<outline text="All the complexity is for when it doesn't work. What about when it does?">
								</outline>
							</outline>
						</outline>
						<outline text="var ctRetries = 0, idSocketChecker;">
						</outline>
						<outline text="const ctSecsBetwRetries = 10;">
						</outline>
						<outline text="const maxRetries = 100; ">
						</outline>
						<outline text="const initialCheckTimeout = 100; //5/4/25 by DW">
						</outline>
						<outline text="">
						</outline>
						<outline text="var flGoodnightDialogShowing = false; ">
						</outline>
						<outline text="if (options.flWebsocketEnabled) { //2/8/23 by DW">
							<outline text="var mySocket = undefined;">
							</outline>
							<outline text="function handleGoodnightMessage () {">
								<outline text="if (options.flWatchSocketForOtherCopies) { //12/20/21 by DW">
									<outline text="if (!flGoodnightDialogShowing) {">
										<outline text="flGoodnightDialogShowing = true;">
										</outline>
										<outline text="mySocket.close (1000, &quot;Received goodnight message.&quot;); //1000 is the code for normal closure">
										</outline>
										<outline text="alertDialog (options.goodnightDialogMsg, function () {">
											<outline text="location.reload (true);">
											</outline>
											<outline text="});">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="function checkConnection () {">
								<outline text="if ((mySocket === undefined) &amp;&amp; (!flGoodnightDialogShowing)) { //5/25/24 by  DW -- don't reopen socket after being told to go away">
									<outline text="mySocket = new WebSocket (options.urlChatLogSocket); ">
									</outline>
									<outline text="mySocket.onopen = function (evt) {">
										<outline text="ctRetries = 0; //5/1/25 by DW -- we got through">
										</outline>
										<outline text="if (userIsSignedIn ()) { //2/8/23 by DW">
											<outline text="const msg = &quot;greetings &quot; + wordpressMemory.accessToken;">
											</outline>
											<outline text="console.log (&quot;wsConnectToServer: connection open, sending greetings to wpIdentity server.&quot;);">
											</outline>
											<outline text="mySocket.send (msg);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="};">
										</outline>
									</outline>
									<outline text="mySocket.onmessage = function (evt) {">
										<outline text="if (evt.data !== undefined) { //no error">
											<outline text="console.log (&quot;wsConnectToServer: evt.data == &quot; + evt.data);">
											</outline>
											<outline text="switch (evt.data) {">
												<outline text="case &quot;goodnight&quot;:">
													<outline text="handleGoodnightMessage (); ">
													</outline>
													<outline text="break;">
													</outline>
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="};">
										</outline>
									</outline>
									<outline text="mySocket.onclose = function (evt) {">
										<outline text="mySocket = undefined;">
										</outline>
										<outline text="if (ctRetries++ &gt;= maxRetries) { //5/1/25 by DW">
											<outline text="clearInterval (idSocketChecker);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="};">
										</outline>
									</outline>
									<outline text="mySocket.onerror = function (evt) {">
										<outline text="console.log (&quot;wsConnectToServer: socket received an error.&quot;);">
										</outline>
										<outline text="};">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="setTimeout (function () { //5/4/25 by DW">
								<outline text="checkConnection ();">
								</outline>
								<outline text="idSocketChecker = setInterval (checkConnection, 1000 * ctSecsBetwRetries);">
								</outline>
								<outline text="console.log (&quot;wsConnectToServer: idSocketChecker == &quot; + idSocketChecker);">
								</outline>
								<outline text="}, initialCheckTimeout);">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUserInfo (callback) {">
						<outline text="if (wordpressMemory.userinfo === undefined) { //3/9/25 by DW">
							<outline text="getUserInfoFromServer (function (err, theUserInfo) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="wordpressMemory.userinfo = theUserInfo;">
									</outline>
									<outline text="saveWordpressMemory ();">
									</outline>
									<outline text="callback (undefined, theUserInfo);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="})">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="callback (undefined, wordpressMemory.userinfo);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUserInfoSync () { //10/26/24 by DW">
						<outline text="return (wordpressMemory.userinfo);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSitePosts (idsite, callback) { //8/28/23 by DW">
						<outline text="wpServerCall (&quot;wordpressgetsiteposts&quot;, {idsite}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSiteUsers (idsite, callback) { //8/28/23 by DW">
						<outline text="wpServerCall (&quot;wordpressgetsiteusers&quot;, {idsite}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSiteInfo (idsite, callback) { //8/29/23 by DW">
						<outline text="var flfound = false;">
						</outline>
						<outline text="wordpressMemory.sitelist.forEach (function (item) {">
							<outline text="if (item.idSite == idsite) {">
								<outline text="callback (undefined, item);">
								</outline>
								<outline text="flfound = true;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="if (!flfound) {">
							<outline text="wpServerCall (&quot;wordpressgetsiteinfo&quot;, {idsite}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSiteInfoSync (idsite) { //8/18/25 by DW">
						<outline text="var siteinfo = undefined;">
						</outline>
						<outline text="wordpressMemory.sitelist.forEach (function (item) {">
							<outline text="if (item.idSite == idsite) {">
								<outline text="siteinfo = item;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="return (siteinfo);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSiteMedialist (idsite, callback) { //8/29/23 by DW">
						<outline text="wpServerCall (&quot;wordpressgetsitemedialist&quot;, {idsite}, true, callback);">
						</outline>
