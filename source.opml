						</outline>
						<outline text="this.getUserInfo = function (callback) {" isComment="true">
							<outline text="if (wordpressMemory.userinfo === undefined) { //3/9/25 by DW">
								<outline text="getUserInfo (function (err, theUserInfo) {">
									<outline text="if (err) {">
										<outline text="callback (err);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="wordpressMemory.userinfo = theUserInfo;">
										</outline>
										<outline text="saveWordpressMemory ();">
										</outline>
										<outline text="callback (undefined, theUserInfo);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="})">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="callback (undefined, wordpressMemory.userinfo);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getUserInfoSync = function () { //10/26/24 by DW" isComment="true">
							<outline text="return (wordpressMemory.userinfo);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getSitePosts = function (idsite, callback) { //8/28/23 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressgetsiteposts&quot;, {idsite}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getSiteUsers = function (idsite, callback) { //8/28/23 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressgetsiteusers&quot;, {idsite}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getSiteInfo = function (idsite, callback) { //8/29/23 by DW" isComment="true">
							<outline text="var flfound = false;">
							</outline>
							<outline text="wordpressMemory.sitelist.forEach (function (item) {">
								<outline text="if (item.idSite == idsite) {">
									<outline text="callback (undefined, item);">
									</outline>
									<outline text="flfound = true;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="if (!flfound) {">
								<outline text="wpServerCall (&quot;wordpressgetsiteinfo&quot;, {idsite}, true, callback);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getSiteMedialist = function (idsite, callback) { //8/29/23 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressgetsitemedialist&quot;, {idsite}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getSiteCategories = function (idsite, callback) { //10/19/24 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressgetsitecategories&quot;, {idsite}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getPost = function (idsite, idpost, callback) { //8/28/23 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressgetpost&quot;, {idsite, idpost}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.addPost = function (idsite, thepost, callback) { //8/29/23 by DW" isComment="true">
							<outline text="if (options.flMarkdownProcess) {">
								<outline text="thepost.content = markdownProcess (thepost.content);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="const jsontext = JSON.stringify (thepost);">
							</outline>
							<outline text="wpServerCall (&quot;wordpressaddpost&quot;, {idsite, jsontext}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.updatePost = function (idsite, idpost, thepost, callback) { //8/29/23 by DW" isComment="true">
							<outline text="if (options.flMarkdownProcess) {">
								<outline text="thepost.content = markdownProcess (thepost.content);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="const jsontext = JSON.stringify (thepost);">
							</outline>
							<outline text="wpServerCall (&quot;wordpressupdatepost&quot;, {idsite, idpost, jsontext}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.deletePost = function (idsite, idpost, callback) { //9/4/23 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressdeletepost&quot;, {idsite, idpost}, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getSubscriptions = function (callback) { //9/5/23 by DW" isComment="true">
							<outline text="wpServerCall (&quot;wordpressgetsubscriptions&quot;, undefined, true, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getRecentUserDrafts = function (idsite, callback) { //4/27/24 by DW" isComment="true">
							<outline text="var params = {">
								<outline text="maxdrafts: options.maxCtUserDraftFiles,">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="if (idsite !== undefined) { //4/30/24 by DW">
								<outline text="params.idsite = idsite;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="wpServerCall (&quot;wordpressgetrecentuserdrafts&quot;, params, true, function (err, theList) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="var theList = JSON.parse (data);" isComment="true">
									</outline>
									<outline text="theList.forEach (function (item) {">
										<outline text="item.whenCreated = new Date (item.whenCreated);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="callback (undefined, theList);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.getUserFileInfo = function (callback) { //5/16/24 by DW" isComment="true">
							<outline text="var params = {">
								<outline text="maxfiles: options.maxCtUserDraftFiles,">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="wpServerCall (&quot;wordpressgetuserfileinfo&quot;, params, true, function (err, theList) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="callback (undefined, theList);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
			</outline>
			<outline text="client/styles.css">
				<outline text="@import url('https://fonts.googleapis.com/css?family=Oswald:400,700');">
				</outline>
