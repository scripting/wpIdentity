					</outline>
					<outline text="">
					</outline>
					<outline text="//testing functions, mostly commented out -- 10/24/24 by DW">
						<outline text="this.testGetNextRangeOfDraftsForUser = function () { //8/5/25 by DW" isComment="true">
							<outline text="const maxcalls = 200;">
							</outline>
							<outline text="function nextcall (ix) {">
								<outline text="if (ix &lt; maxcalls) {">
									<outline text="getNextRangeOfDraftsForUser (function (err, theArray) {">
										<outline text="if (err) {">
											<outline text="console.log (err.message);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="console.log (&quot;\n\nix == &quot; + ix + &quot;, theArray.length == &quot; + theArray.length);">
											</outline>
											<outline text="theArray.forEach (function (item) {">
												<outline text="console.log (item.idDraft + &quot;: &quot; + new Date (item.whenCreated).toLocaleString ());">
												</outline>
												<outline text="});">
												</outline>
											</outline>
											<outline text="if (theArray.length == 0) {">
												<outline text="console.log (&quot;bing!&quot;);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="if ((ix &lt; maxcalls) &amp;&amp; (theArray.length &gt; 0)) {">
												<outline text="nextcall (ix + 1);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="nextcall (1); //get drafts until there aren't any more">
							</outline>
							<outline text="}">
							</outline>
						</outline>
