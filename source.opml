					</outline>
					<outline text="function getPost (idsite, idpost, callback) { //8/28/23 by DW">
						<outline text="wpServerCall (&quot;wordpressgetpost&quot;, {idsite, idpost}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function deletePost (idsite, idpost, callback) { //9/4/23 by DW">
