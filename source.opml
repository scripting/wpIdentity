									<outline text="return (true);">
									</outline>
								</outline>
								<outline text="case &quot;/wordpressgetedgesforuser&quot;: //4/9/26 by DW">
									<outline text="callWithUsername (function (username) {">
										<outline text="getEdges (username, params.idsite, params.idpost, httpReturn);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="return (true);">
									</outline>
								</outline>
								<outline text="case &quot;/wordpressgetwordlanddraft&quot;: //3/16/26 by DW">
									<outline text="getWordlandDraft (params.idsite, params.idpost, httpReturn);">
									</outline>
									<outline text="return (true);">
									</outline>
								</outline>
								<outline text="case &quot;/wordpresssavefeed&quot;: //3/28/26 by DW">
									<outline text="tokenRequired (function (token) {">
										<outline text="saveFeed (token, params.idsite, httpReturn);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="return (true);">
									</outline>
								</outline>
								<outline text="">
								</outline>
								<outline text="case &quot;/wordpressgetsourcefiles&quot;: //4/11/26 by DW">
									<outline text="callWithUsername (function (username) {">
										<outline text="getSourceFiles (username, params.idsite, params.idpost, httpReturn);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="return (true);">
									</outline>
								</outline>
								<outline text="case &quot;/wordpressdeletesourcefiles&quot;: //4/11/26 by DW">
									<outline text="callWithUsername (function (username) {">
										<outline text="const paths = (params.paths === undefined) ? undefined : JSON.parse (params.paths);">
										</outline>
										<outline text="deleteSourceFiles (username, params.idsite, params.idpost, paths, httpReturn);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="return (true);">
									</outline>
								</outline>
								<outline text="">
								</outline>
								<outline text="default:">
									<outline text="if (config.flServePublicUserFiles) { //4/30/24 by DW">
										<outline text="return (servePublicFile (theRequest.lowerpath)); ">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="return (false);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
						</outline>
						<outline text="case &quot;options&quot;:" isComment="true">
							<outline text="var headers = {">
								<outline text="&quot;Access-Control-Allow-Origin&quot;: &quot;*&quot;,">
								</outline>
								<outline text="&quot;Access-Control-Allow-Methods&quot;: &quot;GET, POST, OPTIONS&quot;,">
								</outline>
								<outline text="&quot;Access-Control-Allow-Headers&quot;: &quot;Content-Type, Authorization&quot;">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="theRequest.sysResponse.writeHead (204, headers);">
							</outline>
							<outline text="theRequest.sysResponse.end ();">
							</outline>
							<outline text="return (true);">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function start (options, callback) {">
					<outline text="function startLog () { //12/21/24 by DW">
						<outline text="const logOptions = {">
							<outline text="};">
							</outline>
						</outline>
						<outline text="log.start (logOptions, function () {">
							<outline text="const eventData = {">
								<outline text="urlServer: config.urlServer">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="addToLog (&quot;start&quot;, undefined, eventData);">
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function everyMinute () {">
						<outline text="readAuthorizedAccounts (); //11/18/24 by DW">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function everySecond () { //2/27/25 by DW">
						<outline text="checkStats ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="console.log (&quot;wpIdentity.start: options == &quot; + utils.jsonStringify (options));">
					</outline>
					<outline text="if (options !== undefined) {">
						<outline text="for (var x in options) {">
							<outline text="if (options [x] !== undefined) {">
								<outline text="config [x] = options [x];">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (options.database !== undefined) { //3/24/24 by DW">
							<outline text="startStorage (options.database, function () {">
								<outline text="fixBookmarksFile (); //10/28/24 by DW" isComment="true">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="startLog (); //12/21/24 by DW">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="webSocketStartup (); //5/24/24 by DW">
						</outline>
						<outline text="startStats (); //2/27/25 by DW">
						</outline>
						<outline text="startMail (); //12/2/25 by DW">
						</outline>
						<outline text="testMailsend (); //12/2/25 by DW" isComment="true">
						</outline>
						<outline text="setInterval (everySecond, 1000);  //2/27/25 by DW">
						</outline>
						<outline text="everyMinute (); //11/18/24 by DW">
						</outline>
						<outline text="utils.runEveryMinute (everyMinute); //11/18/24 by DW">
						</outline>
						<outline text="if (callback !== undefined) {">
							<outline text="callback ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
			</outline>
			<outline text="client/api2.js">
				<outline text="function wordpress (userOptions, callback) {">
					<outline text="Changes" isComment="true">
						<outline text="3/11/25; 6:23:55 PM by DW">
							<outline text="Added calls to wpServerCall and wpServerPost.">
							</outline>
						</outline>
						<outline text="3/9/25; 12:52:03 PM by DW">
							<outline text="this.getUserInfo returned wordpressMemory.userinfo, which works in WordLand because it calls the this.start which gets it at startup. ">
							</outline>
							<outline text="but now we have an app that doesn't call this. start, so this.getUserInfo has to take that possibility into account that it hasn't been set. ">
							</outline>
						</outline>
						<outline text="4/7/24; 10:23:32 AM by DW">
							<outline text="Added a callback, not optional. ">
							</outline>
							<outline text="If the user is signed in, we get the sitelist, the first time and save it in wordpressMemory.">
							</outline>
						</outline>
					</outline>
					<outline text="var wordpressMemory = { //saved in localstorage">
						<outline text="accessToken: undefined,">
						</outline>
						<outline text="sitelist: undefined">
						</outline>
						<outline text="};">
						</outline>
					</outline>
					<outline text="var options = {">
						<outline text="serverAddress: undefined,">
						</outline>
						<outline text="flMarkdownProcess: false, //11/15/25 by DW -- changed to false">
						</outline>
						<outline text="maxCtUserDraftFiles: 1000, //10/31/24 by DW">
						</outline>
						<outline text="flWebsocketEnabled: true, //5/24/24 by DW">
						</outline>
						<outline text="urlChatLogSocket: &quot;ws://localhost:1622/&quot;,">
						</outline>
						<outline text="flWatchSocketForOtherCopies: true,">
						</outline>
						<outline text="goodnightDialogMsg: &quot;WordLand is running in another tab. Click OK to reload this tab, or you can safely close it without losing any work.&quot;, //12/22/24 by DW">
						</outline>
						<outline text="ctDraftsPerPage: 250 //8/5/25 by DW">
						</outline>
						<outline text="};">
						</outline>
					</outline>
					<outline text="if (userOptions !== undefined) { //allow caller to override defaults">
						<outline text="for (x in userOptions) {">
							<outline text="if (userOptions [x] !== undefined) {">
								<outline text="options [x] = userOptions [x];">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function saveWordpressMemory () {">
						<outline text="console.log (&quot;saveWordpressMemory&quot;);" isComment="true">
						</outline>
						<outline text="localStorage.wordpressMemory = jsonStringify (wordpressMemory);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function handleAccesstoken () { //10/3/23 by DW">
						<outline text="function gotToken (accessToken) {">
							<outline text="wordpressMemory.accessToken = base64UrlDecode (accessToken);">
							</outline>
							<outline text="saveWordpressMemory ();">
							</outline>
							<outline text="var newHref = stringNthField (location.href, &quot;?&quot;, 1);">
							</outline>
							<outline text="newHref = stringNthField (newHref, &quot;#&quot;, 1);">
							</outline>
							<outline text="location.href = newHref;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="const accessToken = getURLParameter (&quot;wordpressaccesstoken&quot;);">
						</outline>
						<outline text="if (accessToken != &quot;null&quot;) {">
							<outline text="gotToken (accessToken);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="if (location.hash.length &gt; 0) {">
								<outline text="let hash = location.hash;">
								</outline>
								<outline text="if (beginsWith (hash, &quot;#?&quot;)) {">
									<outline text="hash = stringDelete (hash, 1, 2);">
									</outline>
									<outline text="const allparams = getAllUrlParams (hash);">
									</outline>
									<outline text="if (allparams.wordpressaccesstoken !== undefined) {">
										<outline text="gotToken (allparams.wordpressaccesstoken);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="handleAccesstoken ();">
					</outline>
					<outline text="">
					</outline>
					<outline text="if (localStorage.wordpressMemory !== undefined) {">
						<outline text="let jstruct = JSON.parse (localStorage.wordpressMemory);">
						</outline>
						<outline text="for (var x in jstruct) {">
							<outline text="wordpressMemory [x] = jstruct [x];">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function getServerAddress () {">
						<outline text="return (options.serverAddress); ">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUsername () { //8/29/25 by DW">
						<outline text="return (wordpressMemory.userinfo.username);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getFeedUrl (username, idsite) { //5/15/25 by DW">
						<outline text="username = (username === undefined) ? getUsername () : username;  //8/29/25 by DW">
						</outline>
						<outline text="const feedUrl = options.serverAddress +  username + &quot;/&quot; + idsite + &quot;/rss.xml&quot;; //https://wordland.social/scripting/237777565/rss.xml">
						</outline>
						<outline text="return (feedUrl);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function markdownProcess (mdtext) {">
						<outline text="const replacetable = {">
							<outline text="&quot;\\.&quot;: &quot;.&quot;,">
							</outline>
							<outline text="&quot;\\_&quot;: &quot;_&quot;,">
							</outline>
							<outline text="&quot;\\*&quot;: &quot;*&quot;">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="mdtext = multipleReplaceAll (mdtext, replacetable, false); ">
						</outline>
						<outline text="const md = new Markdown.Converter ();">
						</outline>
						<outline text="const htmltext = md.makeHtml (mdtext);">
						</outline>
						<outline text="return (htmltext);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function base64UrlEncode (data) {">
						<outline text="let base64 = btoa (unescape (encodeURIComponent (data)));">
						</outline>
						<outline text="return base64.replace ('+', '-').replace ('/', '_').replace (/=+$/, '');">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function base64UrlDecode (theData) {">
						<outline text="theData = theData.replace ('-', '+').replace ('_', '/');">
						</outline>
						<outline text="while (theData.length % 4) {">
							<outline text="theData += '=';">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="return (decodeURIComponent (escape (atob (theData))));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function arrayBufferToBase64 (buffer) { //11/13/24 by DW">
						<outline text="const bytes = new Uint8Array (buffer);">
						</outline>
						<outline text="let binary = &quot;&quot;;">
						</outline>
						<outline text="for (let i = 0; i &lt; bytes.byteLength; i++) {">
							<outline text="binary += String.fromCharCode (bytes [i]);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="return (btoa (binary));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getDateForSorting (theDate) { //6/3/23 by DW">
						<outline text="if (theDate === undefined) {">
							<outline text="return (new Date (0));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="return (new Date (theDate));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function httpRequest (url, timeout, headers, callback) { ">
						<outline text="Changes" isComment="true">
							<outline text="7/22/22; 12:30:36 PM by DW">
								<outline text="If there's no message, say there was a communication error. We have to say something. ;-)">
								</outline>
							</outline>
							<outline text="9/18/21; 10:47:11 AM by DW">
								<outline text="When there's an error, usually there is a status.responseText to parse as JSON, but sometimes it fails. Now we account for that. ">
								</outline>
							</outline>
							<outline text="7/20/20; 5:36:14 PM by DW">
								<outline text="Finally, I need a HTTP request routine that calls back in a standard way.">
									<outline text="function (err, data)">
									</outline>
								</outline>
								<outline text="No, I don't want to use promises.">
								</outline>
								<outline text="for info about timeous see this page." isComment="true">
									<outline text="http://stackoverflow.com/questions/3543683/determine-if-ajax-error-is-a-timeout">
									</outline>
								</outline>
							</outline>
						</outline>
						<outline text="timeout = (timeout === undefined) ? 30000 : timeout;">
						</outline>
						<outline text="var jxhr = $.ajax ({ ">
							<outline text="url: url,">
							</outline>
							<outline text="dataType: &quot;text&quot;, ">
							</outline>
							<outline text="headers,">
							</outline>
							<outline text="timeout">
							</outline>
							<outline text="}) ">
							</outline>
						</outline>
						<outline text=".success (function (data, status) { ">
							<outline text="callback (undefined, data);">
							</outline>
							<outline text="}) ">
							</outline>
						</outline>
						<outline text=".error (function (status) { ">
							<outline text="var message;">
							</outline>
							<outline text="try { //9/18/21 by DW">
								<outline text="message = JSON.parse (status.responseText).message;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="catch (err) {">
								<outline text="message = status.responseText;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="if ((message === undefined) || (message.length == 0)) { //7/22/22 by DW &amp; 8/31/22 by DW">
								<outline text="message = &quot;There was an error communicating with the server.&quot;;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="var err = {">
								<outline text="code: status.status,">
								</outline>
								<outline text="message">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="callback (err);">
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function userIsSignedIn () {">
						<outline text="return (wordpressMemory.accessToken !== undefined);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUserInfoFromServer (callback) { //8/26/23 by DW">
						<outline text="Changes" isComment="true">
							<outline text="9/18/25; 10:16:02 AM by DW">
								<outline text="Changed the name from getUserInfo to getUserInfoFromServer.">
								</outline>
							</outline>
						</outline>
						<outline text="wpServerCall (&quot;wordpressgetuserinfo&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUserSites (callback) { //8/26/23 by DW">
						<outline text="wpServerCall (&quot;wordpressgetusersites&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function initUserInfo (callback) {">
						<outline text="Changes" isComment="true">
							<outline text="3/17/25; 12:24:02 PM by DW">
								<outline text="Previously we only read userinfo if we didn't already have a copy. ">
								</outline>
								<outline text="Instead, it should go to the server at startup, the only time this function is called.">
								</outline>
							</outline>
						</outline>
						<outline text="getUserInfoFromServer (function (err, userinfo) { //3/17/25 by DW">
							<outline text="if (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="wordpressMemory.userinfo = userinfo;">
								</outline>
								<outline text="saveWordpressMemory ();">
								</outline>
								<outline text="console.log (&quot;initUserInfo: wordpressMemory.userinfo == &quot; + jsonStringify (wordpressMemory.userinfo));">
								</outline>
								<outline text="callback ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="if (wordpressMemory.userinfo === undefined) {" isComment="true">
							<outline text="getUserInfo (function (err, userinfo) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="wordpressMemory.userinfo = userinfo;">
									</outline>
									<outline text="saveWordpressMemory ();">
									</outline>
									<outline text="console.log (&quot;initUserInfo: wordpressMemory.userinfo == &quot; + jsonStringify (wordpressMemory.userinfo));">
									</outline>
									<outline text="callback ();">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {" isComment="true">
							<outline text="callback ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function initSitelist (callback) {">
						<outline text="Changes" isComment="true">
							<outline text="10/10/24; 2:36:56 PM by DW">
								<outline text="we were never updating the site list, that was ridiculous. ">
								</outline>
								<outline text="now we're going to update the site list at startup, but not wait for it to return.">
								</outline>
								<outline text="it takes about a second to run. but it'll be running in the background.">
								</outline>
							</outline>
							<outline text="4/12/24; 10:45:16 AM by DW">
								<outline text="No longer abbreviating sitelist, it's already being done on the server. I want more info to be available on the client side. ">
								</outline>
							</outline>
						</outline>
						<outline text="const whenstart = new Date ();">
						</outline>
						<outline text="getUserSites (function (err, theSitelist) {">
							<outline text="if (!err) {">
								<outline text="theSitelist.forEach (function (item) { //4/12/24 by DW">
									<outline text="try {">
										<outline text="item.whenCreated = new Date (item.whenCreated);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="catch (err) {">
										<outline text="}">
										</outline>
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="wordpressMemory.sitelist = theSitelist;">
								</outline>
								<outline text="saveWordpressMemory ();">
								</outline>
								<outline text="console.log (&quot;initSitelist: wordpressMemory.sitelist.length == &quot; + wordpressMemory.sitelist.length + &quot;, &quot; + secondsSince (whenstart) + &quot; secs.&quot;);" isComment="true">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="callback (undefined); //we're not waiting for this to complete">
						</outline>
						<outline text="if (wordpressMemory.sitelist === undefined) {" isComment="true">
							<outline text="function getAbbreviatedList (theSitelist) {">
								<outline text="const theList = new Array ();">
								</outline>
								<outline text="theSitelist.forEach (function (item) {">
									<outline text="theList.push ({">
										<outline text="idSite: item.idSite, ">
										</outline>
										<outline text="urlSite: item.urlSite,">
										</outline>
										<outline text="name: item.name,">
										</outline>
										<outline text="description: item.description,">
										</outline>
										<outline text="whenCreated: item.whenCreated">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="return (theList);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="getUserSites (function (err, theSitelist) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="theSitelist.forEach (function (item) { //4/12/24 by DW">
										<outline text="try {">
											<outline text="item.whenCreated = new Date (item.whenCreated);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="catch (err) {">
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="wordpressMemory.sitelist = theSitelist;">
									</outline>
									<outline text="wordpressMemory.sitelist = getAbbreviatedList (theSitelist);" isComment="true">
									</outline>
									<outline text="saveWordpressMemory ();">
									</outline>
									<outline text="console.log (&quot;initSitelist: wordpressMemory.sitelist == &quot; + jsonStringify (wordpressMemory.sitelist));">
									</outline>
									<outline text="callback (undefined);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {" isComment="true">
							<outline text="callback ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function wpServerPost (path, params, flAuthenticated, filedata, callback, urlServer=getServerAddress ()) { //3/24/24 by DW">
						<outline text="Changes" isComment="true">
							<outline text="5/9/24; 11:27:23 AM by DW">
								<outline text="Rewritten per the conversation with ChatGPT.">
									<outline text="https://chatgpt.com/share/7f8d9567-2790-4e9a-b699-0b87bfad1174?oai-dm=1">
									</outline>
								</outline>
							</outline>
							<outline text="11/1/23; 9:55:40 AM by DW">
								<outline text="Don't add oauth params (for twitter) if they are not defined. ">
								</outline>
							</outline>
							<outline text="4/22/23; 1:24:18 PM by DW">
								<outline text="Change twBuildParamList call to buildParamList.">
								</outline>
							</outline>
							<outline text="8/2/21; 2:19:56 PM by DW">
								<outline text="If filedata is not a PlainObject or a string, convert it to a string.">
								</outline>
							</outline>
							<outline text="2/25/21; 1:01:58 PM by DW">
								<outline text="A special form of servercall for posts.">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;wpServerPost&quot;);" isComment="true">
						</outline>
						<outline text="var whenstart = new Date ();">
						</outline>
						<outline text="if (!$.isPlainObject (filedata) &amp;&amp; (typeof (filedata) != &quot;string&quot;)) { //8/2/21 by DW">
							<outline text="filedata = filedata.toString ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (params === undefined) {">
							<outline text="params = new Object ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (flAuthenticated) {">
							<outline text="params.token = base64UrlEncode (wordpressMemory.accessToken);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="var url = urlServer + path + &quot;?&quot; + buildParamList (params, false);">
						</outline>
						<outline text="$.post (url, filedata) //5/9/24 by DW">
							<outline text=".done (function (data, textStatus) {">
								<outline text="if (callback !== undefined) {">
									<outline text="callback (undefined, data);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="console.log (&quot;Response Data:&quot;, data);" isComment="true">
								</outline>
								<outline text="console.log (&quot;Status:&quot;, textStatus);" isComment="true">
								</outline>
								<outline text="})">
								</outline>
							</outline>
							<outline text=".fail (function (jqXHR, textStatus, errorThrown) {">
								<outline text="if (callback !== undefined) {">
									<outline text="let err = {">
										<outline text="message: jqXHR.responseText || textStatus //3/26/25 by DW">
										</outline>
										<outline text="message: textStatus" isComment="true">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="console.log (&quot;Failed with status:&quot;, textStatus);" isComment="true">
								</outline>
								<outline text="console.log (&quot;Error thrown:&quot;, errorThrown);" isComment="true">
								</outline>
								<outline text="console.log (&quot;Response error:&quot;, jqXHR.responseText);" isComment="true">
								</outline>
								<outline text="});">
								</outline>
							</outline>
						</outline>
						<outline text="$.post (url, filedata, function (data, status) {" isComment="true">
							<outline text="if (status == &quot;success&quot;) {">
								<outline text="console.log (&quot;wpServerPost: url == &quot; + url + &quot;, secs == &quot; + secondsSince (whenstart)); " isComment="true">
								</outline>
								<outline text="if (callback !== undefined) {">
									<outline text="callback (undefined, data);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="var err = {">
									<outline text="code: status.status,">
									</outline>
									<outline text="message: JSON.parse (status.responseText).message">
									</outline>
									<outline text="};">
									</outline>
								</outline>
								<outline text="if (callback !== undefined) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="httpRequest (url, undefined, undefined, function (err, jsontext) {" isComment="true">
							<outline text="if (err) {">
								<outline text="console.log (&quot;servercall: url == &quot; + url + &quot;, err.message == &quot; + err.message);">
								</outline>
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="console.log (&quot;servercall: url == &quot; + url + &quot;, secs == &quot; + secondsSince (whenstart)); ">
								</outline>
								<outline text="callback (undefined, JSON.parse (jsontext));">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function wpServerCall (path, params, flAuthenticated, callback, urlServer=getServerAddress ()) {">
						<outline text="Changes" isComment="true">
							<outline text="4/22/23; 1:24:18 PM by DW">
								<outline text="Change twBuildParamList call to buildParamList.">
								</outline>
							</outline>
							<outline text="12/23/22; 10:30:22 PM by DW">
								<outline text="Support email params. Don't send oauth token if it's not defined.">
								</outline>
							</outline>
							<outline text="12/10/21; 12:51:58 PM by DW">
								<outline text="New optional parameter, urlServer, so this function can be used to call Daytona.">
								</outline>
							</outline>
							<outline text="1/11/21; 12:51:47 PM by DW">
								<outline text="New param, flAuthenticated. If true we add the oAuth info to the call. ">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;wpServerCall&quot;);" isComment="true">
						</outline>
						<outline text="const whenstart = new Date ();">
						</outline>
						<outline text="var headers = undefined;">
						</outline>
						<outline text="if (params === undefined) {">
							<outline text="params = new Object ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (flAuthenticated) {">
							<outline text="params.token = base64UrlEncode (wordpressMemory.accessToken);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="var url = urlServer + path + &quot;?&quot; + buildParamList (params, false);">
						</outline>
						<outline text="console.log (&quot;wpServerCall: url == &quot; + url);" isComment="true">
						</outline>
						<outline text="httpRequest (url, undefined, headers, function (err, jsontext) {">
							<outline text="if (err) {">
								<outline text="console.log (&quot;wpServerCall: url == &quot; + url + &quot;, err.message == &quot; + err.message);" isComment="true">
								</outline>
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="console.log (&quot;wpServerCall: jsontext.length == &quot; + jsontext.length + &quot;, secs == &quot; + secondsSince (whenstart)); " isComment="true">
								</outline>
								<outline text="callback (undefined, JSON.parse (jsontext));">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function readUserDataFile (relpath, flPrivate, callback, options) { //3/25/24 by DW">
						<outline text="Changes" isComment="true">
							<outline text="4/5/24; 12:54:30 PM by DW">
								<outline text="New optional param, options, comes after the callback. Sorry. It's a late addition.">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;readUserDataFile&quot;);" isComment="true">
						</outline>
						<outline text="const whenstart = new Date ();">
