								</outline>
								<outline text="">
								</outline>
								<outline text="&lt;div class=&quot;divLogonButton&quot;&gt;">
									<outline text="&lt;center&gt;">
										<outline text="&lt;img alt=&quot;&quot; src=&quot;//s0.wp.com/i/wpcc-button.png&quot; width=&quot;231&quot; scale=&quot;0&quot; onclick=&quot;connectWithWordpress ()&quot;&gt;">
										</outline>
										<outline text="&lt;/center&gt;">
										</outline>
									</outline>
									<outline text="&lt;/div&gt;">
									</outline>
								</outline>
								<outline text="&lt;div class=&quot;divSignonDialog&quot;&gt;" isComment="true">
									<outline text="&lt;div class=&quot;divSignonDialogPrompt&quot;&gt;">
										<outline text="&lt;span class=&quot;spSignonDialogPromptText&quot;&gt;">
											<outline text="&lt;span class=&quot;spMembershipClosed&quot;&gt;Sorry! Membership is closed.&lt;/span&gt;">
											</outline>
											<outline text="&lt;span class=&quot;spMembershipOpen&quot;&gt;Welcome to FeedLand!&lt;/span&gt;">
											</outline>
											<outline text="&lt;span class=&quot;spMembershipOpen&quot;&gt;Please sign on to enter FeedLand.&lt;/span&gt;" isComment="true">
											</outline>
											<outline text="&lt;/span&gt;">
											</outline>
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
									<outline text="&lt;div class=&quot;divSignonExplanation&quot;&gt;">
										<outline text="&lt;span class=&quot;spSignonExplanationText&quot;&gt;">
											<outline text="&lt;span class=&quot;spMembershipClosed&quot;&gt;In order to provide good service to current users we can't accept new members at this time. Hopefully this is just a temporary situation. &lt;/span&gt;">
											</outline>
											<outline text="&lt;span class=&quot;spMembershipOpen&quot;&gt;FeedLand is a place to share and discover feeds. &lt;i&gt;Sign up&lt;/i&gt; to create a new account, or &lt;i&gt;Sign on&lt;/i&gt; to access a previously created account.&lt;/span&gt;">
											</outline>
											<outline text="" isComment="true">
											</outline>
											<outline text="FeedLand is a place to share and discover feeds. " isComment="true">
											</outline>
											<outline text="We use Twitter to &lt;a href=&quot;http://scripting.com/2022/06/08/144243.html?title=whatIsIdentity&quot; target=&quot;_blank&quot;&gt;identify&lt;/a&gt; each user. " isComment="true">
											</outline>
											<outline text="Sign on here to access the community of feeds and readers. " isComment="true">
											</outline>
											<outline text="" isComment="true">
											</outline>
											<outline text="It's a magic place where everyone is happy all day. We all pitch in and report bugs carefully with exactly the right information. We add feeds that make everyone smarter. We are happy, fun-loving, smart and generous people! :-)" isComment="true">
											</outline>
											<outline text="" isComment="true">
											</outline>
											<outline text="Sign on to record your tweets in OPML, in a public place where all kinds of apps can access them, including outliners, readers, renderers and databases. " isComment="true">
											</outline>
											<outline text="We will periodically update your public outline, that can be shared, with items you post on Twitter. You can use your tweets in your writing, to manage your work, or update others. Twitter becomes your mobile &quot;Tools For Thought&quot; notepad. " isComment="true">
											</outline>
											<outline text="&lt;/span&gt;">
											</outline>
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
									<outline text="&lt;div class=&quot;divSignonButtons&quot;&gt;">
										<outline text="&lt;div class=&quot;divSignonButton&quot;&gt;">
											<outline text="&lt;span class=&quot;spMembershipOpen&quot;&gt;">
												<outline text="&lt;span class=&quot;spTwitterForIdentity&quot;&gt;">
													<outline text="&lt;button id=&quot;idNotLoggedOnTwitterButton&quot;  class=&quot;btn&quot; type=&quot;button&quot; onclick=&quot;signOnButtonClick ();&quot;&gt;">
														<outline text="&lt;i class=&quot;fab fa-twitter&quot; style=&quot;color: #4099FF; font-weight: bold;&quot;&gt;&lt;/i&gt;&amp;nbsp;Sign on Twitter">
														</outline>
														<outline text="&lt;/button&gt;">
														</outline>
													</outline>
													<outline text="&lt;/span&gt;">
													</outline>
												</outline>
												<outline text="&lt;span class=&quot;spNotTwitterForIdentity&quot;&gt;">
													<outline text="&lt;table&gt;">
														<outline text="&lt;tr&gt;">
															<outline text="&lt;td style=&quot;padding-left: 5px; padding-right: 5px;&quot;&gt;">
																<outline text="&lt;span class=&quot;spMembershipOpen&quot;&gt;&lt;button  class=&quot;btn&quot; onclick=&quot;signUpCommand ();&quot;&gt;Sign up&lt;/button&gt;&lt;/span&gt;">
																</outline>
																<outline text="&lt;/td&gt;">
																</outline>
															</outline>
															<outline text="&lt;td style=&quot;padding-left: 5px; padding-right: 5px;&quot;&gt;">
																<outline text="&lt;button  class=&quot;btn btn-primary&quot; onclick=&quot;signOnCommand ();&quot;&gt;Sign on&lt;/button&gt;">
																</outline>
																<outline text="&lt;/td&gt;">
																</outline>
															</outline>
															<outline text="&lt;/tr&gt;">
															</outline>
														</outline>
														<outline text="&lt;/table&gt;">
														</outline>
													</outline>
													<outline text="&lt;/span&gt;">
													</outline>
												</outline>
												<outline text="&lt;/span&gt;">
												</outline>
											</outline>
											<outline text="&lt;/div&gt;">
											</outline>
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
									<outline text="&lt;div class=&quot;divSignonButtons&quot;&gt;" isComment="true">
										<outline text="&lt;div class=&quot;divSignonButton&quot;&gt;">
											<outline text="&lt;span class=&quot;spMembershipOpen&quot;&gt;">
												<outline text="&lt;button id=&quot;idNotLoggedOnTwitterButton&quot;  class=&quot;btn&quot; type=&quot;button&quot; onclick=&quot;signOnButtonClick ();&quot;&gt;">
													<outline text="&lt;i class=&quot;fab fa-twitter&quot; style=&quot;color: #4099FF; font-weight: bold;&quot;&gt;&lt;/i&gt;&amp;nbsp;Sign on Twitter">
													</outline>
													<outline text="&lt;/button&gt;">
													</outline>
												</outline>
												<outline text="&lt;/span&gt;">
												</outline>
											</outline>
											<outline text="&lt;/div&gt;">
											</outline>
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
									<outline text="&lt;/div&gt;">
									</outline>
								</outline>
								<outline text="&lt;/div&gt;">
								</outline>
							</outline>
							<outline text="&lt;/div&gt;">
							</outline>
						</outline>
						<outline text="&lt;script&gt;">
							<outline text="$(document).ready (function () {">
								<outline text="startup ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="&lt;/script&gt;">
							</outline>
