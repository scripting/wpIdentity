						<outline text="this.startup = function (callback) {" isComment="true">
							<outline text="if (userIsSignedIn ()) {">
								<outline text="initSitelist (function (err) {">
									<outline text="initUserInfo (function (err) {">
										<outline text="wsConnectUserToServer (); //5/24/24 by DW">
