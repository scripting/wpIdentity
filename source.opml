					<outline text="function getSourceFiles (idsite, idpost, callback) { //4/11/26 by DW">
						<outline text="wpServerCall (&quot;wordpressgetsourcefiles&quot;, {idsite, idpost}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function deleteSourceFiles (idsite, idpost, paths, callback) { //4/11/26 by DW">
						<outline text="if (paths !== undefined) {">
							<outline text="paths = JSON.stringify (paths);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="wpServerCall (&quot;wordpressdeletesourcefiles&quot;, {idsite, idpost, paths}, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function connectWithWordpress () {">
						<outline text="const url = getServerAddress () + &quot;connect?urlapphomepage=&quot; + encodeURIComponent (location.href); //9/4/23 by DW">
						</outline>
						<outline text="console.log (&quot;connectWithWordpress: url == &quot; + url);">
						</outline>
						<outline text="location.href = url;">
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="location.href = &quot;https://wpidentity.scripting.com/connect&quot;;" isComment="true">
						</outline>
						<outline text="location.href = &quot;http://localhost:1408/connect&quot;;" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function logOffWordpress () {">
						<outline text="delete localStorage.wordpressMemory;">
						</outline>
						<outline text="location.reload ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function startup (callback) {">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="initSitelist (function (err) {">
								<outline text="initUserInfo (function (err) {">
									<outline text="wsConnectUserToServer (); //5/24/24 by DW">
									</outline>
									<outline text="callback ();">
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="callback (undefined);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="this.getUserInfo = getUserInfo;">
					</outline>
					<outline text="this.getUserInfoSync = getUserInfoSync;">
					</outline>
					<outline text="this.getUserSites = getUserSites;">
					</outline>
					<outline text="this.getSitePosts = getSitePosts; //8/28/23 by DW">
					</outline>
					<outline text="this.getSiteUsers = getSiteUsers; //8/29/23 by DW">
					</outline>
					<outline text="this.getSiteInfo = getSiteInfo; //8/29/23 by DW">
					</outline>
					<outline text="this.getSiteInfoSync = getSiteInfoSync; //8/18/25 by DW">
					</outline>
					<outline text="this.getSiteMedialist = getSiteMedialist; //8/29/23 by DW">
					</outline>
					<outline text="this.getSiteCategories = getSiteCategories; //10/19/24 by DW">
					</outline>
					<outline text="this.getPost = getPost; //8/28/23 by DW">
					</outline>
					<outline text="this.deletePost = deletePost;  //9/5/23 by DW">
					</outline>
					<outline text="this.getSubscriptions = getSubscriptions;   //9/5/23 by DW">
					</outline>
					<outline text="this.getRecentUserDrafts = getRecentUserDrafts;   //4/27/24 by DW">
					</outline>
					<outline text="this.getUserFileInfo = getUserFileInfo;  //5/16/24 by DW">
					</outline>
					<outline text="this.readUserDataFile = readUserDataFile;">
					</outline>
					<outline text="this.writeUserDataFile = writeUserDataFile;">
					</outline>
					<outline text="this.writeUniqueFile = writeUniqueFile; //5/12/24 by DW">
					</outline>
					<outline text="this.readDraft = readDraft;  //5/29/24 by DW">
					</outline>
					<outline text="this.deleteDraft = deleteDraft; //5/29/24 by DW">
					</outline>
					<outline text="this.getNextDraft = getNextDraft; //10/29/24 by DW">
					</outline>
					<outline text="this.getPrevDraft = getPrevDraft; //10/29/24 by DW">
					</outline>
					<outline text="this.getNextPrevArray = getNextPrevArray; //11/1/24 by DW">
					</outline>
					<outline text="this.getAllDraftsForUser = getAllDraftsForUser; //3/19/25 by DW">
					</outline>
					<outline text="this.getNextRangeOfDraftsForUser = getNextRangeOfDraftsForUser; //8/5/25 by DW">
					</outline>
					<outline text="this.uploadImageFile = uploadImageFile; //11/11/24 by DW">
					</outline>
					<outline text="this.servercall = wpServerCall; //3/11/25 by DW">
					</outline>
					<outline text="this.serverpost = wpServerPost; //3/11/25 by DW">
					</outline>
					<outline text="this.addCategory = addCategory; //3/15/25 by DW">
