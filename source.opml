						<outline text="this.readUserJsonFile = function (relpath, flPrivate, callback, options) {" isComment="true">
							<outline text="readUserDataFile (relpath, flPrivate, function (err, theFileData) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="var theJsonData = new Object (), flJsonError = false;">
									</outline>
									<outline text="try {">
										<outline text="theJsonData = JSON.parse (theFileData.filecontents);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="catch (err) {">
										<outline text="callback (err);">
										</outline>
										<outline text="flJsonError = true;">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="if (!flJsonError) {">
										<outline text="callback (undefined, theJsonData);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}, options);">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="this.deleteUserDataFile = function (relpath, flPrivate, callback) { //3/26/24 by DW" isComment="true">
