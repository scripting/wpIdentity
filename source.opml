			<outline text="client/code.js">
				<outline text="const flUseLocalServer = false;">
				</outline>
				<outline text="">
				</outline>
				<outline text="const myServerAddress = (flUseLocalServer) ? &quot;http://localhost:1408/&quot; : &quot;https://wpidentity.scripting.com/&quot;;" isComment="true">
				</outline>
				<outline text="" isComment="true">
				</outline>
				<outline text="var myWordpress;">
				</outline>
				<outline text="">
				</outline>
				<outline text="var appPrefs = {">
					<outline text="ctMinutesRunning: 0,">
					</outline>
					<outline text="whenLastMinute: new Date (0), ">
					</outline>
					<outline text="localTime: &quot;&quot;,">
					</outline>
					<outline text="currentSlogan: &quot;&quot;">
					</outline>
					<outline text="};">
					</outline>
				</outline>
				<outline text="const fnamePrefs = &quot;demo/prefs.json&quot;;">
				</outline>
				<outline text="var flPrefsChanged = false;">
				</outline>
				<outline text="">
				</outline>
				<outline text="function logOffWordpress () {">
					<outline text="confirmDialog (&quot;Log off WordPress.com?&quot;, function () {">
						<outline text="myWordpress.logOffWordpress ();">
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function addToolTip (theObject, tipText, placement=&quot;right&quot;) { //8/24/22 by DW">
					<outline text="Changes" isComment="true">
						<outline text="11/1/22; 9:55:02 AM by DW">
							<outline text="In some circumstances, when you click on an item with a tooltip, the tooltip lingers around after the click. I added code that looks for the click and hides the tooltip.">
							</outline>
						</outline>
						<outline text="10/23/22; 12:41:25 PM by DW">
							<outline text="Some tooltips I link to menu items are cut off at the boundary of something related to menus. The recommended way to deal with it is to add a data-container value of body.">
								<outline text="https://getbootstrap.com/docs/4.0/components/popovers/#example-using-the-container-option">
								</outline>
							</outline>
						</outline>
					</outline>
					<outline text="$(theObject).attr (&quot;data-container&quot;, &quot;body&quot;); //10/23/22 by DW">
					</outline>
					<outline text="$(theObject).attr (&quot;data-toggle&quot;, &quot;tooltip&quot;);">
					</outline>
					<outline text="$(theObject).attr (&quot;data-placement&quot;, placement);">
					</outline>
					<outline text="$(theObject).attr (&quot;title&quot;, tipText);">
					</outline>
					<outline text="$(theObject).click (function () { //11/1/22 by DW">
						<outline text="$(theObject).tooltip (&quot;hide&quot;);">
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="return (theObject);">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function activateToolTips () { //8/28/22 by DW">
					<outline text="$(&quot;[data-toggle=\&quot;tooltip\&quot;]&quot;).tooltip ();">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function getFeedlandTimeString (when, flLongStrings=false) {">
					<outline text="const options = {">
						<outline text="flBriefYearDates: true,">
						</outline>
						<outline text="nowString: &quot;now&quot;">
						</outline>
						<outline text="};">
						</outline>
					</outline>
					<outline text="var s = getFacebookTimeString (when, flLongStrings, options);">
					</outline>
					<outline text="s = replaceAll (s, &quot;Just now&quot;, &quot;now&quot;);" isComment="true">
					</outline>
					<outline text="return (s);">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function userInteracted () { //5/17/21 by DW">
					<outline text="console.log (&quot;userInteracted&quot;);" isComment="true">
					</outline>
					<outline text="whenLastUserAction = new Date ();" isComment="true">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function decodeHtmlEntities (htmltext) {" isComment="true">
					<outline text="var textarea = document.createElement (&quot;textarea&quot;);">
					</outline>
					<outline text="textarea.innerHTML = htmltext;">
					</outline>
					<outline text="return (textarea.value);">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function prefsChanged () {">
					<outline text="flPrefsChanged = true;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function readPrefs (callback) {">
					<outline text="const whenstart = new Date ();">
					</outline>
					<outline text="myWordpress.readUserDataFile (fnamePrefs, true, function (err, theSavedPrefs) {">
						<outline text="if (err) {">
							<outline text="console.log (&quot;readPrefs: err.message == &quot; + err.message);" isComment="true">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="var thePrefs = new Object (), flJsonError = false;">
							</outline>
							<outline text="try {">
								<outline text="thePrefs = JSON.parse (theSavedPrefs.filecontents);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="catch (err) {">
								<outline text="console.log (&quot;readPrefs: err.message == &quot; + err.message);">
								</outline>
								<outline text="flJsonError = true;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="if (!flJsonError) {">
								<outline text="for (var x in thePrefs) {">
									<outline text="appPrefs [x] = thePrefs [x];">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="cleanAppPrefs ();" isComment="true">
							</outline>
							<outline text="console.log (&quot;readPrefs: &quot; + secondsSince (whenstart) + &quot; secs&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (callback !== undefined) {">
							<outline text="callback (err, theSavedPrefs);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function savePrefs (callback) {">
					<outline text="const jsontext = jsonStringify (appPrefs), whenstart = new Date ();">
					</outline>
					<outline text="myWordpress.writeUniqueFile (fnamePrefs, jsontext, &quot;application/json&quot;, true, function (err, data) {">
						<outline text="if (err) {">
							<outline text="console.log (&quot;savePrefs: err.message == &quot; +  err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="console.log (&quot;savePrefs: &quot; + secondsSince (whenstart) + &quot; secs&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (callback !== undefined) {">
							<outline text="callback (err, data);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="myWordpress.writeUserDataFile (fnamePrefs, jsontext, &quot;application/json&quot;, true, function (err, data) {" isComment="true">
						<outline text="if (err) {">
							<outline text="console.log (&quot;savePrefs: err.message == &quot; +  err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="console.log (&quot;savePrefs: &quot; + secondsSince (whenstart) + &quot; secs&quot;);" isComment="true">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (callback !== undefined) {">
							<outline text="callback (err, data);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function sortSiteList (theSites, sortBy=&quot;name&quot;, flReverseSort=false) {">
					<outline text="theSites.sort (function (a, b) {">
						<outline text="cribsheet" isComment="true">
							<outline text="if a &gt; b return 1">
							</outline>
							<outline text="if a &lt; b return -1">
							</outline>
						</outline>
						<outline text="switch (sortBy) {">
							<outline text="case &quot;name&quot;:">
								<outline text="var alower = a.name.toLowerCase (), val;">
								</outline>
								<outline text="var blower = b.name.toLowerCase ();">
								</outline>
								<outline text="if (flReverseSort) { //7/11/22 by DW">
									<outline text="let tmp = alower;">
									</outline>
									<outline text="alower = blower;">
									</outline>
									<outline text="blower = tmp;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="if (alower.length == 0) {">
									<outline text="return (1);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="if (blower.length == 0) {">
									<outline text="return (-1);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="if (alower == blower) {">
									<outline text="val = 0;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="if (blower &gt; alower) {">
										<outline text="val = -1;">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="val = 1;">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="return (val);">
								</outline>
							</outline>
							<outline text="case &quot;whenUpdated&quot;:" isComment="true">
								<outline text="var adate = getDateForSorting (a.whenUpdated), bdate = getDateForSorting (b.whenUpdated);">
								</outline>
								<outline text="if (flReverseSort) { //7/11/22 by DW">
									<outline text="let tmp = adate;">
									</outline>
									<outline text="adate = bdate;">
									</outline>
									<outline text="bdate = tmp;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="return (bdate - adate);">
								</outline>
							</outline>
							<outline text="case &quot;ctSubs&quot;:" isComment="true">
								<outline text="const acount = getCountForSorting (a.ctSubs), bcount = getCountForSorting (b.ctSubs);">
								</outline>
								<outline text="if (flReverseSort) { //7/11/22 by DW">
									<outline text="return (acount - bcount);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="return (bcount - acount);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function viewSitelist (whereToAppend) {">
					<outline text="console.log (&quot;viewSitelist&quot;);">
					</outline>
					<outline text="var options = {">
						<outline text="sortBy: &quot;name&quot;,">
						</outline>
						<outline text="flReverseSort: false">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getRow (item) {">
						<outline text="console.log (&quot;getRow: item == &quot; + jsonStringify (item));" isComment="true">
						</outline>
						<outline text="const theRow = $(&quot;&lt;tr&gt;&lt;/tr&gt;&quot;);">
						</outline>
						<outline text="function getSiteName () {">
							<outline text="const theCell = $(&quot;&lt;td&gt;&lt;/td&gt;&quot;);">
							</outline>
							<outline text="const shortenedname = maxStringLength (item.name, 25, true, true);">
							</outline>
							<outline text="const theName = $(&quot;&lt;span class=\&quot;spSitename\&quot;&gt;&quot; + shortenedname + &quot;&lt;/span&gt;&quot;);">
							</outline>
							<outline text="addToolTip (theName, item.description);">
							</outline>
							<outline text="theCell.append (theName);">
							</outline>
							<outline text="return (theCell);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getDateValue (when, meaning) {">
							<outline text="const theCell = $(&quot;&lt;td&gt;&lt;/td&gt;&quot;);">
							</outline>
							<outline text="const whenstring = getFeedlandTimeString (when);">
							</outline>
							<outline text="const whenstring = new Date (when).toLocaleString ();" isComment="true">
							</outline>
							<outline text="const theDate = $(&quot;&lt;span class=\&quot;spSitedate\&quot;&gt;&quot; + whenstring + &quot;&lt;/span&gt;&quot;);">
							</outline>
							<outline text="addToolTip (theDate, &quot;When the site was &quot; + meaning + &quot;.&quot;);">
							</outline>
							<outline text="theCell.append (theDate);">
							</outline>
							<outline text="return (theCell);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="theRow.append (getSiteName ());">
						</outline>
						<outline text="theRow.append (getDateValue (item.whenCreated, &quot;created&quot;));">
						</outline>
						<outline text="theRow.append (getDateValue (item.options.updated_at, &quot;last updated&quot;));" isComment="true">
						</outline>
						<outline text="return (theRow);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="if (whereToAppend === undefined) {">
						<outline text="whereToAppend = $(&quot;.divSitelistContainer&quot;);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="const theList = myWordpress.getSiteList ();" isComment="true">
					</outline>
					<outline text="">
					</outline>
					<outline text="myWordpress.getUserSites (function (err, theList) {">
						<outline text="if (err) {">
							<outline text="alertDialog (err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="function sortTheList () {">
								<outline text="theList.sites.sort (function (a, b) {">
									<outline text="cribsheet" isComment="true">
										<outline text="if a &gt; b return 1">
										</outline>
										<outline text="if a &lt; b return -1">
										</outline>
									</outline>
									<outline text="switch (options.sortBy) {">
										<outline text="case &quot;name&quot;:">
											<outline text="var alower = a.name.toLowerCase (), val;">
											</outline>
											<outline text="var blower = b.name.toLowerCase ();">
											</outline>
											<outline text="if (options.flReverseSort) { //7/11/22 by DW">
												<outline text="let tmp = alower;">
												</outline>
												<outline text="alower = blower;">
												</outline>
												<outline text="blower = tmp;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="if (alower.length == 0) {">
												<outline text="return (1);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="if (blower.length == 0) {">
												<outline text="return (-1);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="if (alower == blower) {">
												<outline text="val = 0;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="else {">
												<outline text="if (blower &gt; alower) {">
													<outline text="val = -1;">
													</outline>
													<outline text="}">
													</outline>
												</outline>
												<outline text="else {">
													<outline text="val = 1;">
													</outline>
													<outline text="}">
													</outline>
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="return (val);">
											</outline>
										</outline>
										<outline text="case &quot;whenUpdated&quot;:" isComment="true">
											<outline text="var adate = getDateForSorting (a.whenUpdated), bdate = getDateForSorting (b.whenUpdated);">
											</outline>
											<outline text="if (options.flReverseSort) { //7/11/22 by DW">
												<outline text="let tmp = adate;">
												</outline>
												<outline text="adate = bdate;">
												</outline>
												<outline text="bdate = tmp;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="return (bdate - adate);">
											</outline>
										</outline>
										<outline text="case &quot;ctSubs&quot;:" isComment="true">
											<outline text="const acount = getCountForSorting (a.ctSubs), bcount = getCountForSorting (b.ctSubs);">
											</outline>
											<outline text="if (options.flReverseSort) { //7/11/22 by DW">
												<outline text="return (acount - bcount);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="else {">
												<outline text="return (bcount - acount);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="const divSitelist = $(&quot;&lt;div class=\&quot;divSitelist\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="sortSiteList (theList, options.sortBy, options.flReverseSort);">
							</outline>
							<outline text="theList.forEach (function (item) {">
								<outline text="divSitelist.append (getRow (item));">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="whereToAppend.append (divSitelist);">
							</outline>
							<outline text="activateToolTips ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="">
					</outline>
					<outline text="myWordpress.getSiteList (function (err, theList) {" isComment="true">
						<outline text="function sortTheList () {">
							<outline text="theList.sites.sort (function (a, b) {">
								<outline text="cribsheet" isComment="true">
									<outline text="if a &gt; b return 1">
									</outline>
									<outline text="if a &lt; b return -1">
									</outline>
								</outline>
								<outline text="switch (options.sortBy) {">
									<outline text="case &quot;name&quot;:">
										<outline text="var alower = a.name.toLowerCase (), val;">
										</outline>
										<outline text="var blower = b.name.toLowerCase ();">
										</outline>
										<outline text="if (options.flReverseSort) { //7/11/22 by DW">
											<outline text="let tmp = alower;">
											</outline>
											<outline text="alower = blower;">
											</outline>
											<outline text="blower = tmp;">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="if (alower.length == 0) {">
											<outline text="return (1);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="if (blower.length == 0) {">
											<outline text="return (-1);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="if (alower == blower) {">
											<outline text="val = 0;">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="if (blower &gt; alower) {">
												<outline text="val = -1;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="else {">
												<outline text="val = 1;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="return (val);">
										</outline>
									</outline>
									<outline text="case &quot;whenUpdated&quot;:" isComment="true">
										<outline text="var adate = getDateForSorting (a.whenUpdated), bdate = getDateForSorting (b.whenUpdated);">
										</outline>
										<outline text="if (options.flReverseSort) { //7/11/22 by DW">
											<outline text="let tmp = adate;">
											</outline>
											<outline text="adate = bdate;">
											</outline>
											<outline text="bdate = tmp;">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="return (bdate - adate);">
										</outline>
									</outline>
									<outline text="case &quot;ctSubs&quot;:" isComment="true">
										<outline text="const acount = getCountForSorting (a.ctSubs), bcount = getCountForSorting (b.ctSubs);">
										</outline>
										<outline text="if (options.flReverseSort) { //7/11/22 by DW">
											<outline text="return (acount - bcount);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="return (bcount - acount);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (err) {">
							<outline text="alertDialog (err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const divSitelist = $(&quot;&lt;div class=\&quot;divSitelist\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="sortSiteList (theList, options.sortBy, options.flReverseSort);">
							</outline>
							<outline text="theList.forEach (function (item) {">
								<outline text="divSitelist.append (getRow (item));">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="whereToAppend.append (divSitelist);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function reloadSitelist (callback) { //9/3/23 by DW">
					<outline text="$(&quot;.divSitelistContainer&quot;).empty ();">
					</outline>
					<outline text="wordpressMemory.sitelist = undefined;" isComment="true">
					</outline>
					<outline text="viewSitelist ();">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function viewUserInfo (callback) { //9/3/23 by DW">
					<outline text="myWordpress.getUserInfo (function (err, theUserInfo) {">
						<outline text="if (err) {">
							<outline text="alertDialog (err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="console.log (&quot;viewUserInfo: theUserInfo == &quot; + jsonStringify (theUserInfo));">
							</outline>
							<outline text="var htmltext = &quot;&quot;;">
							</outline>
							<outline text="function addLine (label, value) {">
								<outline text="htmltext += &quot;&lt;p&gt;&quot; + label + &quot; = &quot; + value + &quot;.&lt;/p&gt;&quot;;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="addLine (&quot;Username&quot;, theUserInfo.username);">
							</outline>
							<outline text="addLine (&quot;Human name&quot;, theUserInfo.name);">
							</outline>
							<outline text="addLine (&quot;User since&quot;, new Date (theUserInfo.whenStarted).toLocaleString ());">
							</outline>
							<outline text="alertDialog (htmltext);">
							</outline>
							<outline text="if (callback !== undefined) {">
								<outline text="callback ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function userIsSignedIn () {">
					<outline text="return (myWordpress.userIsSignedIn ());">
					</outline>
					<outline text="" isComment="true">
					</outline>
					<outline text="" isComment="true">
					</outline>
					<outline text="return (wordpressMemory.accessToken !== undefined);" isComment="true">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function updateForLogin (flConnected=userIsSignedIn ()) {">
					<outline text="var idActive, idOther;">
					</outline>
					<outline text="if (flConnected) {">
						<outline text="idActive = &quot;#idSignedOn&quot;;">
						</outline>
						<outline text="idOther = &quot;#idSignedOff&quot;;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="else {">
						<outline text="idActive = &quot;#idSignedOff&quot;;">
						</outline>
						<outline text="idOther = &quot;#idSignedOn&quot;;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="if ($(idActive).css (&quot;display&quot;) != &quot;block&quot;) {">
						<outline text="$(idActive).css (&quot;display&quot;, &quot;block&quot;)">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="if ($(idOther).css (&quot;display&quot;) != &quot;none&quot;) {">
						<outline text="$(idOther).css (&quot;display&quot;, &quot;none&quot;)">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function startTestPrefs () { //4/13/24 by DW">
					<outline text="var ct = 0, maxMinutes = 5;">
					</outline>
					<outline text="function testOnce () {">
						<outline text="appPrefs.ctMinutesRunning++;">
						</outline>
						<outline text="appPrefs.whenLastMinute = new Date ();">
						</outline>
						<outline text="appPrefs.currentSlogan = getRandomSnarkySlogan ();">
						</outline>
						<outline text="appPrefs.localTime= new Date ().toLocaleString ();">
						</outline>
						<outline text="prefsChanged ();">
						</outline>
						<outline text="console.log (&quot;testPrefs: appPrefs == &quot; + jsonStringify (appPrefs));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function everyMinute () {">
						<outline text="if (ct++ &lt; maxMinutes) {">
							<outline text="testOnce ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="testOnce (); ">
					</outline>
					<outline text="runEveryMinute (everyMinute);">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function everySecond () {">
					<outline text="updateForLogin ();">
					</outline>
					<outline text="if (flPrefsChanged) { //4/12/24 by DW">
						<outline text="flPrefsChanged = false;">
						</outline>
						<outline text="savePrefs ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function startup () {">
					<outline text="console.log (&quot;startup&quot;);">
					</outline>
					<outline text="const wpOptions = {">
						<outline text="serverAddress: (flUseLocalServer) ? &quot;http://localhost:1408/&quot; : &quot;https://wpidentity.scripting.com/&quot;,">
						</outline>
						<outline text="urlChatLogSocket: (flUseLocalServer) ? &quot;ws://localhost:1408/&quot; : &quot;wss://wpidentity.scripting.com/&quot;,">
						</outline>
						<outline text="flWebsocketEnabled: true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="myWordpress = new wordpress (wpOptions);">
					</outline>
					<outline text="myWordpress.startup (function (err) {">
						<outline text="if (err) {">
							<outline text="alertDialog (&quot;Can't run the app because there was an error starting up.&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="updateForLogin (); ">
							</outline>
							<outline text="if (userIsSignedIn ()) {">
								<outline text="readPrefs (function () { //4/12/24 by DW">
									<outline text="viewSitelist ();">
									</outline>
									<outline text="self.setInterval (everySecond, 1000); ">
									</outline>
									<outline text="startTestPrefs (); //12/23/24 by DW">
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
			</outline>
			<outline text="client/index.html">
				<outline text="&lt;html&gt;">
					<outline text="&lt;head&gt;">
						<outline text="&lt;%basicIncludes2%&gt;">
						</outline>
						<outline text="&lt;%basicoutliner%&gt;" isComment="true">
						</outline>
						<outline text="&lt;%basicMediumEditor%&gt;" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;api2.js&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;script src=&quot;code.js&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;link href=&quot;styles.css&quot; rel=&quot;stylesheet&quot;&gt;">
						</outline>
