					<outline text="function getSubscriptions (callback) { //9/5/23 by DW">
						<outline text="wpServerCall (&quot;wordpressgetsubscriptions&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getRecentUserDrafts (idsite, callback) { //4/27/24 by DW">
						<outline text="var params = {">
							<outline text="maxdrafts: options.maxCtUserDraftFiles,">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="if (idsite !== undefined) { //4/30/24 by DW">
							<outline text="params.idsite = idsite;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="wpServerCall (&quot;wordpressgetrecentuserdrafts&quot;, params, true, function (err, theList) {">
							<outline text="if (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="var theList = JSON.parse (data);" isComment="true">
								</outline>
								<outline text="theList.forEach (function (item) {">
									<outline text="item.whenCreated = new Date (item.whenCreated);">
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="callback (undefined, theList);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUserFileInfo (callback) { //5/16/24 by DW">
						<outline text="var params = {">
							<outline text="maxfiles: options.maxCtUserDraftFiles,">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="wpServerCall (&quot;wordpressgetuserfileinfo&quot;, params, true, function (err, theList) {">
							<outline text="if (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="callback (undefined, theList);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function readUserJsonFile (relpath, flPrivate, callback, options) { //4/10/24 by DW">
						<outline text="readUserDataFile (relpath, flPrivate, function (err, theFileData) {">
							<outline text="if (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="var theJsonData = new Object (), flJsonError = false;">
								</outline>
								<outline text="try {">
									<outline text="theJsonData = JSON.parse (theFileData.filecontents);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="catch (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="flJsonError = true;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="if (!flJsonError) {">
									<outline text="callback (undefined, theJsonData);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}, options);">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function deleteUserDataFile (relpath, flPrivate, callback) { //3/26/24 by DW">
						<outline text="console.log (&quot;deleteUserDataFile&quot;);">
						</outline>
						<outline text="const whenstart = new Date ();">
						</outline>
						<outline text="var params = {">
							<outline text="relpath">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (flPrivate) {">
							<outline text="params.flprivate = true;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="wpServerCall (&quot;wordpressdeletefile&quot;, params, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function isUserWhitelisted (callback) { //10/24/24 by DW">
						<outline text="wpServerCall (&quot;wordpressuseriswhitelisted&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getAccessToken () { //12/24/24 by DW">
						<outline text="const theToken = base64UrlEncode (wordpressMemory.accessToken);">
						</outline>
						<outline text="return (theToken);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSiteList () {">
						<outline text="return (wordpressMemory.sitelist);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getTopUsers (callback) { //12/23/24 by DW">
						<outline text="wpServerCall (&quot;wordpressgettopusers&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getNewPosts (callback) { //2/24/25 by DW">
						<outline text="wpServerCall (&quot;wordpressgettnewposts&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function countUserHit (callback) { //2/26/25 by DW">
						<outline text="wpServerCall (&quot;wordpresscounthit&quot;, undefined, true, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getEdges (idsite, idpost, callback) { //12/4/25 by DW">
						<outline text="Changes" isComment="true">
							<outline text="12/5/25; 3:45:22 PM by DW">
								<outline text="Sort in reverse chronological order.">
								</outline>
							</outline>
						</outline>
						<outline text="function sortEdges (edges) { //4/9/26 by DW">
							<outline text="const flReverseSort = true;">
							</outline>
							<outline text="edges.sort (function (a, b) { //reverse chronologic sort">
								<outline text="cribsheet" isComment="true">
									<outline text="if a &gt; b return 1">
									</outline>
									<outline text="if a &lt; b return -1">
									</outline>
								</outline>
								<outline text="var adate = getDateForSorting (a.whenCreated);">
								</outline>
								<outline text="var bdate = getDateForSorting (b.whenCreated);">
								</outline>
								<outline text="if (flReverseSort) {">
									<outline text="const tmp = adate;">
									</outline>
									<outline text="adate = bdate;">
									</outline>
									<outline text="bdate = tmp;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="return (bdate - adate);">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="return (edges);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (userIsSignedIn ()) {">
							<outline text="wpServerCall (&quot;wordpressgetedgesforuser&quot;, {idsite, idpost}, true, function (err, edges) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="callback (undefined, sortEdges (edges));">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="wpServerCall (&quot;wordpressgetedges&quot;, {idsite, idpost}, false, function (err, edges) {">
								<outline text="if (err) {">
									<outline text="callback (err);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="const flReverseSort = true;" isComment="true">
									</outline>
									<outline text="edges.sort (function (a, b) { //reverse chronologic sort" isComment="true">
										<outline text="cribsheet" isComment="true">
											<outline text="if a &gt; b return 1">
											</outline>
											<outline text="if a &lt; b return -1">
											</outline>
										</outline>
										<outline text="var adate = getDateForSorting (a.whenCreated);">
										</outline>
										<outline text="var bdate = getDateForSorting (b.whenCreated);">
										</outline>
										<outline text="if (flReverseSort) {">
											<outline text="const tmp = adate;">
											</outline>
											<outline text="adate = bdate;">
											</outline>
											<outline text="bdate = tmp;">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="return (bdate - adate);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="callback (undefined, sortEdges (edges));">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getWordlandDraft (idsite, idpost, callback) { //3/16/26 by DW">
						<outline text="wpServerCall (&quot;wordpressgetwordlanddraft&quot;, {idsite, idpost}, false, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function saveFeed (idsite, callback) { //3/28/26 by DW">
						<outline text="wpServerCall (&quot;wordpresssavefeed&quot;, {idsite}, true, callback);">
						</outline>
