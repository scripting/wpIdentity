					<outline text="var flAllDraftsLoaded = false;">
					</outline>
					<outline text="">
					</outline>
					<outline text="function getNextRangeOfDraftsForUser (callback) { //8/5/25 by DW">
						<outline text="Changes" isComment="true">
							<outline text="8/5/25; 11:21:53 AM by DW">
								<outline text="Return the 50 items per request, until there are no more, and then we stop asking.">
								</outline>
								<outline text="The drafts come back in reverse chronologic order.">
								</outline>
							</outline>
						</outline>
						<outline text="if (flAllDraftsLoaded) {">
							<outline text="callback (undefined, new Array ());">
